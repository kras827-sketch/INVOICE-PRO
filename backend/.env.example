# Backend .env example — COPY to `.env` and fill with your keys
# Keep your real `.env` private. This file is a template only.
#
# FOR VERCEL DEPLOYMENT:
# Set these environment variables in Vercel Project Settings > Environment Variables
# Do NOT commit real .env file to git (use .env.local for local testing)

# -----------------------------
# Server
# -----------------------------
PORT=5000
NODE_ENV=development

# Frontend (CORS) url used by backend
# Development: http://localhost:5173
# Production (Vercel): https://your-frontend.vercel.app
FRONTEND_URL=http://localhost:5173

# -----------------------------
# Database
# -----------------------------
# MongoDB connection string. Example:
# mongodb+srv://<user>:<pass>@cluster0.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://oyedeji827_db_user:psy8bbWe0Xcatl1d@cluster0.19rklle.mongodb.net/?appName=invoiceDB


# -----------------------------
# Authentication
# -----------------------------
# JWT secret - keep this long and random
JWT_SECRET=hyyw42u93uhdjwkworkklwkhrhw

# -----------------------------
# Email (Nodemailer) / SMTP
# -----------------------------
# SMTP Configuration (Port 587 for TLS - recommended for production)
# Gmail: Use Gmail App Password (https://myaccount.google.com/apppasswords)
# Other providers: Check their SMTP documentation
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password-16-chars

# Optional: SendGrid instead of Gmail
# Set EMAIL_SERVICE=sendgrid and provide SENDGRID_API_KEY
# SENDGRID_API_KEY=SG.xxxxxxxxxxxx



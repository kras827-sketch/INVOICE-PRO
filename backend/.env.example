GOOGLE_CLIENT_SECRET=

# -----------------------------
# Notes
# -----------------------------
# - Do NOT commit your real `.env` file. Use this template to populate `.env` when ready.
# - If your keys contain special characters or multiline values (like private keys), wrap them in double quotes
#   and escape newlines as \n. Example:
#   FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# - After creating/updating `.env`, restart the backend server so values are picked up.

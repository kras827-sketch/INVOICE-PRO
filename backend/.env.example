# Backend .env example — COPY to `.env` and fill with your keys
# Keep your real `.env` private. This file is a template only.

# -----------------------------
# Server
# -----------------------------
PORT=5000
NODE_ENV=development

# Frontend (CORS) url used by backend
FRONTEND_URL=http://localhost:5173

# -----------------------------
# Database
# -----------------------------
# MongoDB connection string. Example:
# mongodb+srv://<user>:<pass>@cluster0.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=

# -----------------------------
# Authentication
# -----------------------------
# JWT secret - keep this long and random
JWT_SECRET=

# -----------------------------
# Email (Nodemailer) / SMTP
# -----------------------------
# Example Gmail settings (recommended to use app password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# -----------------------------
# Firebase (Service Account)
# -----------------------------
# For Firebase Admin SDK, use service account values. The private key must have newlines escaped (\n)
# Example for FIREBASE_PRIVATE_KEY in .env:
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_STORAGE_BUCKET=

# -----------------------------
# Payments (Paystack)
# -----------------------------
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# -----------------------------
# Optional / Integrations
# -----------------------------
# SendGrid (if using SendGrid instead of SMTP)
SENDGRID_API_KEY=

# AWS S3 for file storage (optional)
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------
# Notes
# -----------------------------
# - Do NOT commit your real `.env` file. Use this template to populate `.env` when ready.
# - If your keys contain special characters or multiline values (like private keys), wrap them in double quotes
#   and escape newlines as \n. Example:
#   FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# - After creating/updating `.env`, restart the backend server so values are picked up.
# - Existing `.env` values you currently have will NOT be modified by this template.

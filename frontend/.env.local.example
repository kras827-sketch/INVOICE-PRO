<!-- FRONTEND .env.local -->
<!-- Get Paystack keys from: https://dashboard.paystack.com/settings/developer -->
REACT_APP_PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here

<!-- Firebase Config (Already configured in src/config/firebase.js) -->
<!-- REACT_APP_FIREBASE_API_KEY=... (in code) -->

<!-- Backend API URL -->
REACT_APP_API_URL=http://localhost:5000
